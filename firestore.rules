rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isSelfEmployee(empId) {
      // Relies on Custom Claims safely set by Admin/Cloud Function
      return isAuthenticated() && request.auth.token.employeeId == empId;
    }

    // --- Collection Rules ---

    // Users: Auth linking
    match /users/{userId} {
      // Employees can read their own auth user doc, Admins read all
      allow read: if isOwner(userId) || isAdmin();
      // Only Admin or System (Cloud Functions) writes
      allow write: if false; 
    }

    // Employee Profiles: Public profile data for the company
    match /employees/{empId} {
      // Employees can read their own profile
      allow read: if isSelfEmployee(empId) || isAdmin();
      // Only Admin can manage profiles
      allow write: if isAdmin();
    }

    // Salary Structures: HIGHLY SENSITIVE
    match /salaryStructures/{empId} {
      // STRICTLY ADMIN ONLY
      allow read, write: if isAdmin();
    }

    // Attendance: Source of Truth
    match /attendance/{attendanceId} {
      // Employees read their own attendance
      allow read: if resource.data.employeeId == request.auth.token.employeeId || isAdmin();
      
      // Writes should be handled via Cloud Functions (Check-in/out) to ensure server timestamps
      // Admin might need manual correction override
      allow write: if isAdmin();
    }

    // Time Off Requests
    match /timeOff/{requestId} {
      // Read own
      allow read: if resource.data.employeeId == request.auth.token.employeeId || isAdmin();
      
      // Create own request
      allow create: if request.resource.data.employeeId == request.auth.token.employeeId;
      
      // Updates (Approval) - Admin only
      allow update: if isAdmin();
      
      // Delete - Admin only or owner if pending? Safe to restrict to Admin/System
      allow delete: if isAdmin();
    }

    // Payroll Records
    match /payroll/{recordId} {
      // Employee sees their own slip
      allow read: if resource.data.employeeId == request.auth.token.employeeId || isAdmin();
      // Generated by System/Admin
      allow write: if isAdmin();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // System generated only
    }
  }
}
